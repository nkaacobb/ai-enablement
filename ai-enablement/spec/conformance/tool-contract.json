    {
      "name": "oneOf refused",
      "input": {
        "tool": {
          "name": "bad",
          "description": "x",
          "inputSchema": {
            "type": "object",
            "properties": {
              "a": {
                "oneOf": [
                  {
                    "type": "string"
                  }
                ]
              }
            }
          }
        }
      },
      "output": {
        "error": "Tool \"bad\": \"a\" uses oneOf, which tool arguments do not support. Describe it with one type, or with an enum."
      }
    },
    {
      "name": "invalid name refused",
      "input": {
        "tool": {
          "name": "9lives",
          "description": "x"
        }
      },
      "output": {
        "error": "Tool name \"9lives\" is not valid: letters, digits, _ or -, starting with a letter, at most 64 characters."
      }
    },
    {
      "name": "reserved name refused",
      "input": {
        "tool": {
          "name": "request_tool",
          "description": "x"
        }
      },
      "output": {
        "error": "\"request_tool\" is reserved."
      }
    },
    {
