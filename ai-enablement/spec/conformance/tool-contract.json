{
  "format": "ai-enablement/conformance/1",
  "suite": "tool-contract",
  "description": "normalizeTool and toMcpTool: a tool definition (handler left out) becomes the runtime's contract and its MCP descriptor, or is refused with the reason. Effects come from \"effect\", else MCP annotations, else \"write\".",
  "operation": "normalizeTool({ ...input.tool, run }) -> { tool (functions left out), mcp: toMcpTool(tool) } | { error }",
  "reference": "assets/ai-agent 1.7.0",
  "cases": [
    {
      "name": "shorthand parameters",
      "input": {
        "tool": {
          "name": "filter_orders",
          "description": "Show only orders with this status.",
          "effect": "write",
          "parameters": {
            "status": {
              "type": "enum",
              "values": [
                "open",
                "shipped"
              ],
              "required": true
            },
            "limit": {
              "type": "integer",
              "min": 1,
              "max": 50,
              "default": 10
            }
          }
        }
      },
      "output": {
        "tool": {
          "name": "filter_orders",
          "title": "Filter orders",
          "description": "Show only orders with this status.",
          "parameters": {
            "status": {
              "type": "enum",
              "values": [
                "open",
                "shipped"
              ],
              "required": true
            },
            "limit": {
              "type": "integer",
              "min": 1,
              "max": 50,
              "default": 10
            }
          },
          "effect": "write",
          "pages": [],
          "when": null,
          "group": "",
          "toolset": "",
          "enabled": false,
          "timeoutMs": 30000
        },
        "mcp": {
          "name": "filter_orders",
          "title": "Filter orders",
          "description": "Show only orders with this status.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "shipped"
                ]
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50
              }
            },
            "required": [
              "status"
            ]
          },
          "annotations": {
            "title": "Filter orders",
            "readOnlyHint": false,
            "destructiveHint": false,
            "openWorldHint": false
          }
        }
      }
    },
