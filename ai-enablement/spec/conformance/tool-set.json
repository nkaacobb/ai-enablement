{
  "format": "ai-enablement/conformance/1",
  "suite": "tool-set",
  "description": "What one request offers: classifyTools splits the tools into callable / off / elsewhere (the user's toolStates, then the tool's enabled; pages match exactly or by a prefix ending in *); toolSpecs are the neutral specs sent natively (non-read tools get a suffix saying what they change); request_tool lists the tools that are off; buildToolPrompt is the TOOLS section, verbatim (text mode lists the callable tools with their parameters).",
  "operation": "tools = input.tools.map(normalizeTool); classes = classifyTools(tools, sanitizeSettings(input.settings), input.pageId) -> names; specs = [...toolSpecs(callable), requestToolSpec(off) if any]; prompt = buildToolPrompt({ classes, mode: input.mode, enabled: settings.toolsEnabled, appOff: input.appOff })",
  "reference": "assets/ai-agent 1.7.0",
  "cases": [
    {
      "name": "native, on the editor page",
      "input": {
        "tools": [
          {
            "name": "find_text",
            "description": "Find text.",
            "effect": "read",
            "enabled": true,
            "parameters": {
              "query": {
                "type": "string",
                "required": true,
                "maxLength": 200
              },
              "limit": {
                "type": "integer",
                "min": 1,
                "max": 50
              }
            }
          },
          {
            "name": "set_size",
            "description": "Font size.",
            "effect": "write",
            "enabled": true,
            "parameters": {
              "size": {
                "type": "number",
                "min": 8,
                "max": 72
              },
              "unit": {
                "type": "enum",
                "values": [
                  "px",
                  "pt"
                ],
                "required": true
              }
            }
          },
          {
            "name": "delete_doc",
            "description": "Delete the document.",
            "effect": "destructive"
          },
          {
            "name": "send_mail",
            "description": "Send it.",
            "effect": "external",
            "enabled": true,
            "parameters": {
              "to": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "name": "chart_zoom",
            "description": "Zoom the chart.",
            "effect": "write",
            "enabled": true,
            "pages": [
              "charts/*"
            ]
          },
          {
            "name": "only_here",
            "description": "Works on one page.",
            "effect": "read",
            "enabled": true,
            "pages": [
              "settings"
            ]
          }
        ],
        "pageId": "editor",
        "mode": "native"
      },
      "output": {
        "callable": [
          "find_text",
          "set_size",
          "send_mail"
        ],
        "off": [
          "delete_doc"
        ],
        "elsewhere": [
          "chart_zoom",
          "only_here"
        ],
        "specs": [
          {
            "name": "find_text",
            "description": "Find text.",
            "parameters": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string",
                  "maxLength": 200
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                }
              },
              "required": [
                "query"
              ]
            }
          },
          {
            "name": "set_size",
            "description": "Font size. (changes the application)",
            "parameters": {
              "type": "object",
              "properties": {
                "size": {
                  "type": "number",
                  "minimum": 8,
                  "maximum": 72
                },
                "unit": {
