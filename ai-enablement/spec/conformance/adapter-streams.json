          "contentType": "text/event-stream",
          "chunks": [
            "event: error\ndata: {\"code\":\"rate-limit\",\"message\":\"Too many questions.\",\"hints\":[\"Wait a minute.\"]}\n\n"
          ]
        }
      },
      "output": {
        "events": [],
        "error": {
          "code": "rate-limit",
          "message": "Too many questions.",
          "hints": [
            "Wait a minute."
          ]
        }
      }
    },
