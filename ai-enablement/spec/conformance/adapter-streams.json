      "input": {
        "provider": "google",
        "model": "gemini-2.5-flash",
        "response": {
          "contentType": "text/event-stream",
          "chunks": [
            "data: {\"promptFeedback\":{\"blockReason\":\"SAFETY\"}}\n\n"
          ]
        }
      },
      "output": {
        "events": [],
        "error": {
          "code": "refused",
          "message": "The provider blocked this request."
        }
      }
    },
    {
      "name": "relay: events, a tool call with its raw text, done",
      "input": {
        "provider": "lmstudio",
        "transport": "relay",
        "relayUrl": "https://app.example/ai-relay",
        "response": {
          "contentType": "text/event-stream",
          "chunks": [
            ": open\n\nevent: status\ndata: {\"message\":\"Loading\"}\n\nevent: reasoning\ndata: {\"text\":\"R.\"}\n\nevent: delta\ndata: {\"text\":\"Hi.\"}\n\nevent: tool_call\ndata: {\"id\":\"r1\",\"name\":\"find_text\",\"arguments\":{\"query\":\"x\"},\"raw\":\"{\\\"query\\\": \\\"x\\\"}\"}\n\nevent: done\ndata: {\"usage\":{\"input\":1,\"output\":2},\"truncated\":true}\n\n"
          ]
        }
      },
      "output": {
        "events": [
          {
            "type": "status",
            "text": "Loading"
          },
          {
            "type": "reasoning",
            "text": "R."
          },
          {
            "type": "text",
            "text": "Hi."
          }
        ],
        "result": {
          "usage": {
            "input": 1,
            "output": 2
          },
          "toolCalls": [
            {
              "id": "r1",
              "name": "find_text",
              "arguments": {
                "query": "x"
              },
              "raw": "{\"query\": \"x\"}"
            }
          ],
          "truncated": true
        }
      }
    },
    {
      "name": "relay: an error event with hints",
